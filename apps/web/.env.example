# The Supabase ⇄ Vercel integration sets these on the Vercel project already
# (plus SUPABASE_URL, SUPABASE_ANON_KEY, POSTGRES_* and, on newer projects,
# SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY). lib/supabase/env.ts accepts
# either naming. Locally, copy the values from Vercel → Settings → Environment
# Variables, or from Supabase → Project Settings → API.

# Public: safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Used inside route handlers after the session check; never shipped to a browser.
# SUPABASE_SECRET_KEY is accepted in its place.
SUPABASE_SERVICE_ROLE_KEY=

# Server only, and the one variable the integration does not set: create it on
# Vercel (any long random string). Vercel Cron sends it as `Authorization: Bearer …`
# to /api/cron/sweep.
CRON_SECRET=

# Public. hCaptcha site key for the name gate; the secret lives in Supabase
# (Authentication → Bot protection). Defaults to the project's key in code.
NEXT_PUBLIC_HCAPTCHA_SITEKEY=
