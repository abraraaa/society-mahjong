# Public: safe in the browser. From Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Used inside route handlers after the session check; never shipped to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Vercel sends it as `Authorization: Bearer …` to /api/cron/sweep.
CRON_SECRET=
